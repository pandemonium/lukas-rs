module Prelude.
module Control.
module IO.
module Data.
module Binary.
module Array.
module Text.
(* module Files. *)

use Stdlib.Prelude.
use Stdlib.Data.
use Stdlib.Data.List.
use Stdlib.Data.Perhaps.
use Stdlib.Data.Result.
use Stdlib.Control.State.
use Stdlib.IO.
(* class methods opened last so polymorphic bind/fold_left shadow the concrete leaks *)
use Stdlib.Control.

signature From ::= ∀α β.
  { from :: α -> β
  }

signature Display ::= ∀α.
  { display :: α -> Text
  }

witness Semigroup Text :=
  { mappend := λp q. "`p``q`"
  }

witness Monoid Text :=
  { mempty := ""
  }

witness Semigroup Int :=
  { mappend := λp q. p + q
  }

witness Monoid Int :=
  { mempty := 0
  }

witness Eq Int :=
  { eq := λp q. p = q
  }

witness Ord Int :=
  { lte := λp q. p <= q
  }

witness Display Text :=
  { display := λt. prim_show t
  }

witness Display Char :=
  { display := λt. prim_show t
  }

witness Display Int :=
  { display := λt. prim_show t
  }
