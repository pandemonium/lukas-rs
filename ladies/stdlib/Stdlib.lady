module Control.
module IO.
module Data.
module Binary.
module Array.
module Text.
(* module Files. *)

use Stdlib.Data.
use Stdlib.Data.List.
use Stdlib.Data.Perhaps.
use Stdlib.Data.Result.
use Stdlib.Control.State.
use Stdlib.IO.
(* class methods opened last so polymorphic bind/fold_left shadow the concrete leaks *)
use Stdlib.Control.

signature From ::= ∀α β.
  { from :: α -> β
  }

(* `Display` (signature + Int/Char/Text witnesses) is in the primordial Prelude, because *)
(* string interpolation desugars to `display`. This module adds Display for its own types. *)

witness Semigroup Text :=
  { mappend := λp q. "`p``q`"
  }

witness Monoid Text :=
  { mempty := ""
  }

witness Semigroup Int :=
  { mappend := λp q. p + q
  }

witness Monoid Int :=
  { mempty := 0
  }

witness Semigroup Float :=
  { mappend := λp q. p + q
  }

witness Monoid Float :=
  { mempty := 0.0
  }

(* Eq/Ord for Int, Float, and Char are primordial (Prelude). *)

(* --------------------------------------------------------------- Eq for tuples *)
(* Derived product equality: tuples are equal element-wise, each element compared by *)
(* its own `Eq` witness. Provided for a useful range of arities. *)
witness ∀α β. Eq α + Eq β |- Eq (α, β) :=
  { eq := λ(a, b) (c, d). eq a c and eq b d
  }

witness ∀α β γ. Eq α + Eq β + Eq γ |- Eq (α, β, γ) :=
  { eq := λ(a, b, c) (d, e, f). eq a d and eq b e and eq c f
  }

witness ∀α β δ ε. Eq α + Eq β + Eq δ + Eq ε |- Eq (α, β, δ, ε) :=
  { eq := λ(a, b, c, d) (e, f, g, h). eq a e and eq b f and eq c g and eq d h
  }

