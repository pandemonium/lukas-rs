(* Stdlib.Console -- ANSI styling, raw mode, and terminal input.

   A console program is a value of type `Console α`, sequenced with `let*` and run by
   `execute`. `module Terminal` below is the wire protocol and the IO that drives it;
   termios and the crash-time restore are in Console.c. *)
use Stdlib.
use Stdlib.IO.
use Stdlib.Data.List.
use Stdlib.Data.Perhaps.
use Stdlib.Control.




(* ============================================================== public types *)

(* ----------------------------------------------------------- the instructions *)

(* CBREAK stops line assembly and echo, leaving signals alone. RAW also takes the signal
   and flow-control keys, and stops LF implying CR on output. *)
Terminal_Mode ::= Cbreak | Raw

Mode_Change ::= Enter_Mode Terminal_Mode | Leave_Mode

Cursor ::= Cursor_Visible | Cursor_Hidden

(* `?1049h` switches to the alternate screen buffer. *)
Screen_Buffer ::= Main_Screen | Alternate_Screen

(* Everything that puts no glyphs on the screen. `New_Line` is here because its spelling
   depends on the mode: `\n` under the driver, `\r\n` in full raw mode. *)
Screen_Control ::=
    New_Line
  | Move_To Int Int
  | Erase_Line
  | Erase_Screen
  | Set_Cursor Cursor
  | Set_Screen Screen_Buffer

(* `β` is the rest of the program; each instruction names the type it hands to it. *)
Console_F ::= ∀β.
    Write Markup (Unit -> β)
  | Screen Screen_Control (Unit -> β)
  | Mode Mode_Change (Bool -> β)
  | Read_Key Wait (Perhaps Key -> β)
  | Read_Line Markup (Perhaps Text -> β)
  | Read_Line_Masked Markup (Perhaps Text -> β)
  | Query_Colour (Bool -> β)
  | Query_Terminal (Bool -> β)
  | Query_Size (Perhaps (Int, Int) -> β)
  | Lift (IO β)

witness Functor Console_F :=
  { fmap := λg instruction.
      deconstruct instruction into
        Write markup next -> Write markup (compose g next)
      | Screen control next -> Screen control (compose g next)
      | Mode change receive -> Mode change (compose g receive)
      | Read_Key wait receive -> Read_Key wait (compose g receive)
      | Read_Line question receive -> Read_Line question (compose g receive)
      | Read_Line_Masked question receive -> Read_Line_Masked question (compose g receive)
      | Query_Colour receive -> Query_Colour (compose g receive)
      | Query_Terminal receive -> Query_Terminal (compose g receive)
      | Query_Size receive -> Query_Size (compose g receive)
      | Lift action -> Lift (fmap g action)
  }

alias Console ::= ∀α. Free Console_F α

(* `Bright` is the basic colour sixty codes up; on `Palette` or `Rgb` it is the identity. *)
Colour ::=
    Black
  | Red
  | Green
  | Yellow
  | Blue
  | Magenta
  | Cyan
  | White
  | Bright Colour
  | Palette Int
  | Rgb Int Int Int

Weight ::= Regular | Bold | Faint


(* `Bool`-carrying rather than on/off constructors, so a style can switch an inherited
   attribute off. *)
Attribute ::=
    Foreground Colour
  | Background Colour
  | Intensity Weight
  | Italic Bool
  | Underline Bool
  | Inverse Bool
  | Strike Bool


opaque Style ::= Make_Style (List Attribute)

(* Styled text, rendered at `write`. Build with `Markup.text` / `paint` / `mappend`. *)
Markup ::=
    Empty_Markup
  | Raw_Markup Text
  | Pair_Markup Markup Markup
  | Styled_Markup Style Markup

(* Whether a render may emit escape sequences. *)
Colour_Mode ::= Coloured | Monochrome

Wait ::= Forever | Milliseconds Int

(* Why a console program stopped early. None of these is something a caller can act
   on, so none of them is in a return type: they end the program, and `execute`
   hands the reason to whoever ran it.

   `Input_Ended` is here rather than in a read's answer because it is *permanent* --
   `Terminal.c` latches it, so no later read will ever succeed. A caller that could
   see it could only stop, and one that retried would spin without even blocking.
   Ctrl-D is NOT this: it is a person cancelling one prompt, they can type at the
   next one, and it is a `Nope` from the read that asked. *)
Fault ::=
    Input_Ended
  | Read_Failed
  | Not_Utf8 Bytes

Modifier ::= Shift | Control | Meta

(* `Character` carries Text because a keystroke may be several bytes. `Ctrl` is the C0
   byte a control key sends directly; `With Control` is a non-character key whose escape
   sequence carried the modifier. *)
Key ::=
    Character Text
  | Ctrl Char
  | Enter
  | Tab
  | Backspace
  | Escape
  | Up
  | Down
  | Left
  | Right
  | Home
  | End
  | Page_Up
  | Page_Down
  | Insert
  | Delete
  | Function Int
  | With Modifier Key
  | Unknown (List Int)

witness Semigroup Style :=
  { mappend := λ(Make_Style earlier) (Make_Style later).
      Make_Style (List.append earlier later)
  }

witness Monoid Style :=
  { mempty := Make_Style Nil
  }

witness Semigroup Markup :=
  { mappend := Pair_Markup
  }

witness Monoid Markup :=
  { mempty := Empty_Markup
  }


witness Display Markup :=
  { display := Markup.render Monochrome
  }

witness From Text Markup :=
  { from := Raw_Markup
  }

witness Display Key :=
  { display := Key.describe
  }


module Terminal.

module Style:
  (* `mempty` for `Style`; renders to "", not `ESC[m`. *)
  plain :: Style := Make_Style Nil
  one :: Attribute -> Style := λattribute. Make_Style (from [attribute])
  fg :: Colour -> Style := λcolour. one (Foreground colour)
  bg :: Colour -> Style := λcolour. one (Background colour)
  bold      :: Style := one (Intensity Bold)
  faint     :: Style := one (Intensity Faint)
  italic    :: Style := one (Italic true)
  underline :: Style := one (Underline true)
  inverse   :: Style := one (Inverse true)
  strike    :: Style := one (Strike true)
  attributes :: Style -> List Attribute := λ(Make_Style chosen). chosen


module Markup:
  text :: Text -> Markup := Raw_Markup
  (* A hard line break. Not `line`, which in a pretty-printer means a SOFT break. *)

  styled :: Style -> Markup -> Markup := Styled_Markup

  paint :: Style -> Text -> Markup := λstyle body.
    Styled_Markup style (Raw_Markup body)
  join :: Markup -> List Markup -> Markup := λseparator parts.
    deconstruct parts into
      Nil -> Empty_Markup
    | Cons first rest ->
        List.fold_left (λacc part. Pair_Markup acc (Pair_Markup separator part)) first rest

  (* `Monochrome` drops every escape -- the same markup, for a pipe or a log. *)
  render :: Colour_Mode -> Markup -> Text := λmode markup.
    List.concat_texts (Terminal.markup_chunks mode Style.plain markup Nil)


module Key:
  (* To BRANCH, match the key: `Character "q"` and `Ctrl \'C\'` are patterns. *)
  character :: Key -> Perhaps Text := λkey.
    deconstruct key into
      Character typed -> This typed
    | otherwise -> Nope

  modifier_name :: Modifier -> Text := λheld.
    deconstruct held into
      Shift -> "Shift"
    | Control -> "Ctrl"
    | Meta -> "Alt"

  (* A readable name, for key-binding tables and for seeing what a terminal sent. *)
  describe :: Key -> Text := λkey.
    deconstruct key into
      Character typed -> "`typed`"
    | Ctrl letter -> "Ctrl-`letter`"
    | With held inner -> "`modifier_name held`+`describe inner`"
    | Function number -> "F`number`"
    | Unknown codes -> "unknown(`List.text ", " codes`)"
    | Enter -> "Enter"
    | Tab -> "Tab"
    | Backspace -> "Backspace"
    | Escape -> "Escape"
    | Up -> "Up"
    | Down -> "Down"
    | Left -> "Left"
    | Right -> "Right"
    | Home -> "Home"
    | End -> "End"
    | Page_Up -> "PageUp"
    | Page_Down -> "PageDown"
    | Insert -> "Insert"
    | Delete -> "Delete"


(* ======================================================== the console itself *)


(* -------------------------------------------------------------------- output *)

write :: Markup -> Console Unit := λmarkup. lift_free (Write markup (λ_. ()))

(* Not a character: see `Screen_Control`. *)
new_line :: Console Unit := lift_free (Screen New_Line (λ_. ()))

write_line :: Markup -> Console Unit := λmarkup.
  let* _ = write markup in
  new_line

write_plain_line :: Text -> Console Unit := λbody. write_line (Markup.text body)

write_plain :: Text -> Console Unit := λbody. write (Markup.text body)

lines :: List Markup -> Console Unit := traverse_ write_line


(* ------------------------------------------------------------- screen control *)

locate :: Int -> Int -> Console Unit := λrow column.
  lift_free (Screen (Move_To row column) (λ_. ()))

home :: Console Unit := locate 1 1

erase_line :: Console Unit := lift_free (Screen Erase_Line (λ_. ()))

erase_screen :: Console Unit := lift_free (Screen Erase_Screen (λ_. ()))

at :: Int -> Int -> Markup -> Console Unit := λrow column content.
  let* _ = locate row column in
  write content

(* Erase and home the cursor: start a frame. *)
clear :: Console Unit :=
  let* _ = erase_screen in
  home


(* ------------------------------------------------------------------- queries *)

(* Is standard OUTPUT a terminal that wants escapes: a tty, NO_COLOR unset, TERM not dumb. *)
supports_colour :: Console Bool := lift_free (Query_Colour id)

(* Is standard INPUT a terminal. *)
is_tty :: Console Bool := lift_free (Query_Terminal id)

(* Columns and rows, or `Nope` where there is no terminal to measure. *)

Console_Size ::=
  { Rows    :: Int
    Columns :: Int
  }

size :: Console (Perhaps Console_Size) :=
  let+ size = lift_free (Query_Size id) in
  fmap (λ(columns, rows). { Rows := rows; Columns := columns } :: Console_Size) size


(* ------------------------------------------------------------- terminal mode *)

(* Raw mode is process-wide device state, so these are brackets, not handles. They nest,
   they are no-ops without a terminal, and Console.c also restores on `atexit` and on the
   fatal signals. *)

(* Echo and line assembly off, signals left alone: what a prompt or a menu wants. *)
in_raw_mode :: ∀α. Console α -> Console α := Terminal.in_mode Cbreak

(* Also takes ^C, ^Z, ^S, ^Q: for a program that draws the whole terminal. *)
in_full_raw_mode :: ∀α. Console α -> Console α := Terminal.in_mode Raw

(* Bracketed for the same reason: leaving either one set wrecks the terminal. *)
in_alternate_screen :: ∀α. Console α -> Console α := λaction.
  let* _ = lift_free (Screen (Set_Screen Alternate_Screen) (λ_. ())) in
  let* result = action in
  let* _ = lift_free (Screen (Set_Screen Main_Screen) (λ_. ())) in
  pure result

with_cursor_hidden :: ∀α. Console α -> Console α := λaction.
  let* _ = lift_free (Screen (Set_Cursor Cursor_Hidden) (λ_. ())) in
  let* result = action in
  let* _ = lift_free (Screen (Set_Cursor Cursor_Visible) (λ_. ())) in
  pure result


(* --------------------------------------------------------------------- input *)

(* One keystroke. Waiting `Forever` has no deadline to miss and the end of input
   ends the program, so there is no second answer to give. In cooked mode the driver
   holds the line until Enter. *)
read_key :: Console Key :=
  (* A `deconstruct` arm, not `perhaps`: arguments are evaluated whether they are
     used or not, so a default of `omg_wtf_bbq` would abort the moment this
     definition was initialised -- which is at the start of every program that loads
     the standard library. *)
  fmap
    (λanswer.
       deconstruct answer into
         This key -> key
       | Nope -> omg_wtf_bbq "Console.read_key: a wait with no deadline timed out")
    (read_key_within Forever)

(* One keystroke, or `Nope` if the deadline passed with nothing pressed -- which is
   the only thing `Nope` means here. The decoder's own 25ms escape framing is
   separate. *)
read_key_within :: Wait -> Console (Perhaps Key) := λwait.
  lift_free (Read_Key wait id)

(* A prompt, then a line, terminator excluded.

   `This ""` is a bare Enter. `Nope` is the person cancelling: Ctrl-D on an empty
   line. It says nothing about the next prompt, so asking again is fine -- unlike
   the input *ending*, which stops the program (see `Fault`). *)
prompt :: Markup -> Console (Perhaps Text) := λquestion.
  lift_free (Read_Line question id)

read_line :: Console (Perhaps Text) := prompt mempty

(* The line, or `otherwise` if the person ended input instead of typing one. *)
read_line_or :: Text -> Console Text := λotherwise.
  prompt_or otherwise mempty

prompt_or :: Text -> Markup -> Console Text := λotherwise question.
  fmap (perhaps otherwise id) (prompt question)

(* A line read with nothing painted: a password prompt. *)
read_masked_line :: Markup -> Console (Perhaps Text) := λquestion.
  lift_free (Read_Line_Masked question id)


(* ---------------------------------------------------------- borrowed effects *)

(* Run an arbitrary `IO` action inside a console program:

       let* text = Console.lift_io (Files.read_file "notes.txt") in
       Console.write_plain_line text

   A lifted action is opaque -- only `execute` can run it. *)
lift_io :: ∀α. IO α -> Console α := λaction. lift_free (Lift action)


(* -------------------------------------------------------- running a program *)

(* `Console ~> IO`: one instruction at a time, each response fed to the continuation waiting
   for it. *)

(* What a fault means, in words -- the two of them are the terminal failing, and a
   program that stops for one should say so rather than vanish. *)
describe_fault :: Fault -> Text := λreason.
  deconstruct reason into
    Input_Ended -> "the input ended"
  | Read_Failed -> "could not read from the terminal"
  | Not_Utf8 _ -> "the input was not valid UTF-8"

(* A whole console program, run: this is what a `start` wants. Faults are reported
   rather than returned, because the alternative is dropping one on the floor -- and
   a program that stops for a reason nobody printed looks like a program that did
   nothing. *)
run :: ∀α. Console α -> IO Unit := λprogram.
  let* outcome = execute program in
  deconstruct outcome into
    Return _ -> pure ()
  (* Running out of input is how a piped program ends, not a complaint. *)
  | Fault Input_Ended -> pure ()
  | Fault reason -> IO.output "console: `describe_fault reason`"

(* The terminal goes back however this ended: a program stopped by a `Fault` never
   reaches its own `in_raw_mode` and `in_alternate_screen` brackets, and leaving
   either one set wrecks the shell the user comes back to. *)
execute :: ∀α. Console α -> IO (Result Fault α) := λprogram.
  let* outcome = interpret program in
  let* _ = Terminal.restore in
  pure outcome

(* A read that fails ends the program: `Read_Failed` and `Not_Utf8` are the terminal
   breaking, and there has never been anything for a caller to do about either. The
   ordinary outcomes -- no more input, the wait ran out -- are a `Nope` handed to the
   continuation like any other answer. *)
interpret :: ∀α. Console α -> IO (Result Fault α) := λprogram.
  deconstruct program into
    (* Reached once per program, however deeply bound. *)
    Pure value ->
      let* _ = Terminal.flush in
      pure (Return value)
  | Step instruction ->
      deconstruct instruction into
        Write markup next ->
          let* _ = Terminal.write_markup markup in
          interpret (next ())
      | Screen control next ->
          let* _ = Terminal.write_control control in
          interpret (next ())
      | Mode change receive ->
          let* entered = Terminal.change_mode change in
          interpret (receive entered)
      (* Output is stdio-buffered; a read is the moment it must be on screen. *)
      | Read_Key wait receive ->
          let* _ = Terminal.flush in
          let* pressed = Terminal.next_key_within wait in
          deconstruct pressed into
            Fault reason -> pure (Fault reason)
          | Return answer -> interpret (receive answer)
      | Read_Line question receive ->
          let* _ = Terminal.flush in
          let* typed = Terminal.prompt_line question in
          deconstruct typed into
            Fault reason -> pure (Fault reason)
          | Return answer -> interpret (receive answer)
      | Read_Line_Masked question receive ->
          let* _ = Terminal.flush in
          let* typed = Terminal.masked_line question in
          deconstruct typed into
            Fault reason -> pure (Fault reason)
          | Return answer -> interpret (receive answer)
      | Query_Colour receive ->
          let* coloured = Terminal.colour_support in
          interpret (receive coloured)
      | Query_Terminal receive ->
          let* terminal = Terminal.input_is_terminal in
          interpret (receive terminal)
      | Query_Size receive ->
          let* measured = Terminal.window_size in
          interpret (receive measured)
      | Lift action ->
          let* next = action in
          interpret next
