(* signature Encoding ::=
  {
  }

signature Decoding ::=
  {
  } *)

witness Display Fault :=
  { display := λself.
      deconstruct self into
        Eof                      -> "End of file"
      | Unexpected_Remains input -> "Unexpected remains: `1`"
      | Unexpected_Input c       -> "Unexpected input `c`"
      | Expected expectation     -> "Found `expectation.Expected`; expected `expectation.Received`"
      | Expected_Number          -> "Expected a number"
      | Bad_Utf_Bytes bytes      -> "Bad UTF `1`"
  }

module Syntax_Tree:
  Node ::=
    Branch Composite
  | Leaf Literal

  Composite ::=
    Array (List Node)
  | Object (List (Text, Node))

  Literal ::=
    String Text
  | Number Float

  witness Display Node :=
    { display := λself.
        deconstruct self into
          Leaf (Number n)        -> "`n`"
        | Leaf (String s)        -> "`s`"
        | Branch (Array elts)    -> "[`elts`]"
        | Branch (Object fields) -> "{`fields`}"
    }

Fault ::=
  Eof
| Unexpected_Remains (Parse.Input)
| Unexpected_Input Char
| Expected Expectation
| Expected_Number
| Bad_Utf_Bytes Bytes

Expectation ::=
  { Expected :: Char
    Received :: Char
  }

module Fault:
  expected :: ∀α. Char -> Char -> Result Fault α := λexpectation received.
    Fault (Expected { Expected := expectation; Received := received })

module Parse:
  is_whitespace :: Char -> Bool := λc.
    c = ' ' or c = '\t' or c = '\n' or c = '\r'

  Input ::=
    { Data     :: Bytes
      Position :: Int
      Limit    :: Int
    }

  module Input:
    from_data :: Bytes -> Input := λdata.
      { Data     := data
        Position := 0
        Limit    := Bytes.length data - 1
      }

    (* scan_start :: Input -> Result Fault Input := λinput. *)

    (* scan past all whitespace *)
    scan :: Input -> Result Fault Input := λinput.
      let is_non_whitespace = λc. not (is_whitespace (Char.of_byte c)) in

      if has_remaining input then
        print_endline "scan: 3"
        deconstruct Bytes.position' input.Data input.Position is_non_whitespace into
          This position ->
            print_endline "scan: position `position`"
            skip input (position - input.Position)
        | Nope          ->
            print_endline "scan: 2"
            Fault Eof
      else
        print_endline "scan: 1"
        Fault Eof

    skip :: Input -> Int -> Result Fault Input := λinput by.
      if input.Position + by <= input.Limit then
        let input' =
          { Data     := input.Data
            Position := by + input.Position
            Limit    := input.Limit
          }
        in pure input'
      else
        print_endline "skip: 1"
        Fault Eof

    has_remaining :: Input -> Bool := λinput.
      input.Position <= input.Limit

    set_at_end :: Input -> Input := λinput.
      { Data     := input.Data
        Position := input.Limit
        Limit    := input.Limit
      }

    at_end :: Input -> Bool := λinput.
      input.Position = input.Limit

    peek :: Input -> Int := λinput.
      Bytes.get_u8 input.Data input.Position

    expect :: Input -> Char -> Result Fault Input := λinput expected.
      let* remains = scan input in
      if peek remains = Int.of_char expected
      then Input.skip remains 1
      else Fault.expected expected (Char.of_byte (peek input))

  json_bytes :: Bytes -> Result Fault Syntax_Tree.Node := λdata.
    let input = Input.from_data data in

    let* remains, root = toplevel input in
    if not (Input.at_end remains)
      then Fault (Unexpected_Remains remains)
      else pure (Syntax_Tree.Branch root)

  toplevel :: Input -> Result Fault (Input, Syntax_Tree.Composite) := λinput.
    let string = λinput.
      (* Move combinator to Input. *)
      let* remains = Input.skip input 1 in
      deconstruct Bytes.position' remains.Data remains.Position (λc. c = Int.of_char '"') into
        This position ->
          print_endline "string: pos `position` remains.Pos `remains.Position`"
          let length = position - remains.Position in
          let text_bytes = Bytes.slice remains.Data remains.Position length in
          let* remains = Input.skip remains (1 + length) in
          print_endline "string: `Char.of_byte (Input.peek remains)`"
          let* text = Result.return_or (λ_. Bad_Utf_Bytes text_bytes) (Text.from_bytes text_bytes) in
          print_endline "string: text [`text`]"
          pure (remains, text)
      | Nope -> Fault Eof
    in

    let string_literal = λinput.
      (* Optimization opportunity - no escapes. *)
      
      let unescape =
        let* out = Buffer.new_buffer

        let escape_sequence = 

        let loop = λi.
          deconstruct Input.peek input i into
            '\' -> 
          | c ->
            let* _ = Buffer.put_u8 out c in
            loop (1 + i)
        in loop 0
      in IO.unsafe_run_IO unescape (* Local effect in still pure function *)
    in

    let is_numeric = λc.
       c >= Int.of_char '0' and c <= Int.of_char '9'
    or c = Int.of_char '+'
    or c = Int.of_char '-'
    or c = Int.of_char 'e'
    or c = Int.of_char 'E'
    or c = Int.of_char '.'

    in

    let number = λinput.
      (* Move combinator to Input. *)
      let number_bytes = Bytes.take_while' input.Data input.Position is_numeric in
      print_endline "number: 1 `Bytes.length number_bytes`"
      let* remains = Input.skip input (Bytes.length number_bytes) in
      print_endline "number: 2"
      let* number_text = Result.return_or (λ_. Bad_Utf_Bytes number_bytes) (Text.from_bytes number_bytes) in
      print_endline "number: 3"
      let* number = Result.return_or (λ_. Expected_Number) (from number_text :: Perhaps Float) in
      print_endline "number: 4 [`number`]"
      pure (remains, Syntax_Tree.Number number)
    in

    let array = λvalue input elements.
      let* remains = Input.skip input 1 (* recursive , or initial [ *) in
      let* remains = Input.scan remains in

      if Int.of_char ']' = Input.peek remains then
        let* remains =
          if not (Input.at_end remains)
            then Input.skip remains 1 (* ] *)
            else pure remains
        in pure (remains, Syntax_Tree.Array elements)
      else
        let* remains, element = value remains in
        let elements = Cons element elements in
        let* remains = Input.scan remains in

        deconstruct Char.of_byte (Input.peek remains) into
          ',' ->
            array value remains elements
        | ']' ->
          let* remains =
            if not (Input.at_end remains)
              then Input.skip remains 1 (* ] *)
              else pure remains
          in pure (remains, Syntax_Tree.Array elements)
        | c -> Fault (Unexpected_Input c)
    in

    let object = λvalue input fields.
      print_endline "object: 1"
      let* remains = Input.skip input 1 (* recursive , or initial { *) in
      print_endline "object: 2"

      let field = λinput.
        let* remains, name = string input in
        print_endline "object: name [`name`]"
        let* remains' = Input.expect remains ':' in
        let* remains'', rhs = value remains' in
        pure (remains'', (name, rhs))
      in
        let* remains = Input.scan remains in

        deconstruct Char.of_byte (Input.peek remains) into
          '}' ->
            let* remains' =
              if not (Input.at_end remains)
              then Input.skip remains 1 (* } *)
              else pure remains
            in pure (remains', Syntax_Tree.Object fields)
        | '"' ->
          let* remains', f = field remains in
          let fields' = Cons f fields in
          let* remains'' = Input.scan remains' in
          deconstruct Char.of_byte (Input.peek remains'') into
            ',' -> object value remains'' fields'
          | '}' ->
            let* remains''' =
              if not (Input.at_end remains'')
              then Input.skip remains'' 1 (* } *)
              else pure remains''
            in pure (remains''', Syntax_Tree.Object fields')
          | c   -> Fault (Unexpected_Input c)
        | c   -> Fault (Unexpected_Input c)
    in

    let value = λinput.
      let* remains = Input.scan input in
      let c = Input.peek remains in
      print_endline "value: 1 -- '`Char.of_byte c`'"

      deconstruct Char.of_byte c into
        '"' ->
          let* remains', literal = string remains in
          pure (remains', Syntax_Tree.Leaf (Syntax_Tree.String literal))
      | '[' ->
        let* remains, arr = array value remains List.empty in
        pure (remains, Syntax_Tree.Branch arr)
      | '{' ->
        let* remains', obj = object value remains List.empty in
        pure (remains', Syntax_Tree.Branch obj)
      | c   ->
        print_endline "value: 2 -- '`c`'"
        if is_numeric (Int.of_char c)
        then
          let* remains', literal = number remains in
          print_endline "value: 3"
          pure (remains', Syntax_Tree.Leaf literal)
        else Fault (Unexpected_Input c)
    in

    (* It is the responsbility of this section of code to deal with end of file conditions. *)
    let* remains = Input.scan input in
    deconstruct Char.of_byte (Input.peek remains) into
      '[' ->
        print_endline "toplevel: 1"
        let* remains', arr = array value remains List.empty in
        print_endline "toplevel: 2"
        deconstruct Input.scan remains' into
          Return remains ->
            print_endline "toplevel: [`Char.of_byte (Input.peek remains)`]; `Input.at_end remains`"
            if Input.at_end remains then
              print_endline "toplevel: at end!"
              pure (remains, arr)
            else
              Fault (Unexpected_Remains remains)
        | Fault _        -> pure (Input.set_at_end remains', arr)
    | '{' ->
      print_endline "toplevel: 3"
      let* remains, obj = object value remains List.empty in
      print_endline "toplevel: 4"

      deconstruct Input.scan remains into
        Return remains ->
          print_endline "toplevel: pos `remains.Position` lim `remains.Limit`"
          if Input.at_end remains then
            print_endline "toplevel: at end!"
            pure (remains, obj)
          else
            Fault (Unexpected_Remains remains)
      | Fault _        -> pure (Input.set_at_end remains, obj)
    | c ->
      Fault (Unexpected_Input c)

(* decode :: ∀α. Decoding α |- Text -> Result Fault α := λjson. *)
