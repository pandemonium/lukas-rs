witness Display Fault :=
  { display := λself.
      deconstruct self into
        Eof                      -> "End of file"
      | Unexpected_Remains input -> "Unexpected remains: `1`"
      | Unexpected_Input c       -> "Unexpected input `c`"
      | Expected expectation     -> "Found `expectation.Received`; expected `expectation.Expected`"
      | Expected_Number          -> "Expected a number"
      | Bad_Utf_Bytes bytes      -> "Bad UTF `1`"
  }

module Syntax_Tree:
  Node ::=
    Branch Composite
  | Leaf Literal

  Composite ::=
    Array (List Node)
  | Object (List (Text, Node))

  Literal ::=
    String Text
  | Number Float

  witness Display Node :=
    { display := λself.
        deconstruct self into
          Leaf (Number n)        -> "`n`"
        | Leaf (String s)        -> "`s`"
        | Branch (Array elts)    -> "[`elts`]"
        | Branch (Object fields) -> "{`fields`}"
    }

Fault ::=
  Eof
| Unexpected_Remains (Parse.Input)
| Unexpected_Input Char
| Expected Expectation
| Expected_Number
| Bad_Utf_Bytes Bytes

Expectation ::=
  { Expected :: Char
    Received :: Char
  }

module Fault:
  expected :: ∀α. Char -> Char -> Result Fault α := λexpectation received.
    Fault (Expected { Expected := expectation; Received := received })

parse :: Text -> Result Fault Syntax_Tree.Node := λjson_text.
  let bytes = Text.to_bytes json_text in
  Parse.json_bytes bytes

module Parse.

(*signature Encoder ::=
  {
  }
 *)

signature Decodes ::= ∀α.
  { decode :: Syntax_Tree.Node -> Result Fault α
  }

alias Decoder ::= ∀α. Syntax_Tree.Node -> Result Fault α

module Decode:
  int :: Syntax_Tree.Node -> Result Fault Input = λnode.
    deconstruct node into
      Syntax_Tree.Literal (Syntax_Tree.Number n) -> Return (Int.of_float n)
    | otherwise -> Fault Expected_Number

decode_text :: ∀α. Decodes α |- Text -> Result Fault α := λjson.
  let* tree = parse json in
  decode tree
