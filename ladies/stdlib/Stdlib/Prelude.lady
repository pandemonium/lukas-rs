id :: ∀α. α -> α :=
  λx. x

flip :: ∀α β r. (α -> β -> r) -> β -> α -> r :=
  λf b a. f a b

compose :: ∀α β γ. (β -> γ) -> (α -> β) -> α -> γ :=
  λg f a. g (f a)

const :: ∀α β. α -> β -> α := λa _. a

module Int:
  foreign raw_int_of_char :: Char -> Int
  of_char :: Char -> Int := raw_int_of_char
