foreign raw_len :: forall a. Array a -> Int
foreign raw_get_element :: forall a. Array a -> Int -> Perhaps a

(* Silently omit the bounds check. Necessary? *)
(* foreign unsafe_get_element :: forall a. Array a -> Int -> Perhaps a *)

(* foreign generate :: forall a. (Int -> a) -> Int -> Array a *)

length :: ∀α. Array α -> Int := raw_len
get_element :: ∀α. Array α -> Int -> Perhaps α := raw_get_element

witness Foldable Array :=
  { fold_right := λstep initial as.
      let loop = λi acc.
        if i < 0 then
          acc
        else
          deconstruct raw_get_element as i into
            This x -> loop (i - 1) (step x acc)
          | Nope   -> loop (i - 1) acc
      in
        loop (raw_len as - 1) initial

    fold_left := λstep initial as.
      let length = raw_len as in
      let loop = λi acc.
        if i >= length then
          acc
        else
          deconstruct raw_get_element as i into
            This x -> loop (i + 1) (step acc x)
          | Nope   -> loop (i + 1) acc
      in
        loop 0 initial
  }
