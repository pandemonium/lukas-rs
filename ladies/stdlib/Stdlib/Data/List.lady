use Stdlib.Control.Enumerator.

List ::= ∀α. Nil | Cons α (List α)

List1 ::= ∀α. { Head :: α; Tail :: List α }

module List1:
  try_from_list :: ∀α. List α -> Perhaps (List1 α) := λxs.
    deconstruct xs into
      Nil       -> Nope
    | Cons x xs -> This ({ Head := x; Tail := xs })

  to_list :: ∀α. List1 α -> List α := λxs.
    Cons xs.Head xs.Tail

  singleton :: ∀α. α -> List1 α := λx.
    { Head := x; Tail := Nil }

  map :: ∀α β. (α -> β) -> List1 α -> List1 β := λf xs.
    { Head := f xs.Head; Tail := List.map f xs.Tail }

  fold_right :: ∀z α. (α -> z -> z) -> z -> List1 α -> z := λf z xs.
    f xs.Head (List.fold_right f z xs.Tail)

  fold_left :: ∀z α. (z -> α -> z) -> z -> List1 α -> z := λf z xs.
    List.fold_left f (f z xs.Head) xs.Tail

  append :: ∀α. List1 α -> List1 α -> List1 α := λxs ys.
    { Head := xs.Head
      Tail := List.append xs.Tail (to_list ys)
    }

  bind :: ∀α β. (α -> List1 β) -> List1 α -> List1 β := λf xs.
    let first = f xs.Head in
    { Head := first.Head
      Tail := List.append first.Tail (List.bind (compose to_list f) xs.Tail)
    }

  traverse1 :: ∀f : *->* α β. Applicative f |- (α -> f β) -> List1 α -> f (List1 β) := λf xs.
    liftA2
      (λhead tail. { Head := head; Tail := tail })
      (f xs.Head)
      (traverse f xs.Tail)

  display1 :: ∀α. Display α |- List1 α -> Text := λxs.
    "`xs.Head`; `xs.Tail`"

  equal :: ∀α. Eq α |- List1 α -> List1 α -> Bool := λxs ys.
    eq xs.Head ys.Head and eq xs.Tail ys.Tail

witness Functor List1 :=
  { fmap := List1.map
  }

witness Foldable List1 :=
  { fold_right := List1.fold_right
    fold_left  := List1.fold_left
  }

witness Applicative List1 :=
  { pure  := List1.singleton
    apply := λfunctions arguments.
      List1.bind (λf. List1.map f arguments) functions
  }

witness Monad List1 :=
  { bind := List1.bind
  }

witness Traversable List1 :=
  { traverse := List1.traverse1
  }

witness ∀α. Semigroup (List1 α) :=
  { mappend := List1.append
  }

witness ∀α. Display α |- Display (List1 α) :=
  { display := List1.display1
  }

witness ∀α. Eq α |- Eq (List1 α) :=
  { eq := List1.equal
  }

witness ∀α. Enumerator α (List α) :=
  { size_hint := λ_. Nope
    next := λxs.
      deconstruct xs into
        Nil -> Nope
      | Cons element remains -> This (element, remains)
  }

indexed_sized :: ∀α. Int -> List α -> Indexed_Enumerator α (List α) := λsize xs.
  Make_Indexed_Enumerator Increasing xs 0 size

(* The generic `From (Foldable t) (List α)` witness lives in Stdlib (not here): in this *)
(* module `fold_right` binds to the concrete function below, which would collapse it to  *)
(* List-only. There, class methods are opened last so it dispatches through the dict.    *)

witness Functor List :=
  { fmap := λf xs.
      deconstruct xs into
        Nil       -> Nil
      | Cons a tl -> Cons (f a) (fmap f tl)
  }

witness Foldable List :=
  { fold_right := λf z xs.
      deconstruct xs into
        Nil       -> z
      | Cons a tl -> f a (fold_right f z tl)
    fold_left := λf z xs.
      deconstruct xs into
        Nil       -> z
      | Cons a tl -> fold_left f (f z a) tl
  }

witness Monad List :=
  { bind := λf xs.
      deconstruct xs into
        Nil       -> Nil
      | Cons a tl -> append (f a) (bind f tl)
  }

witness Applicative List :=
  { pure  := λa. Cons a Nil
    apply := λff fa.
      deconstruct ff into
        Nil       -> Nil
      | Cons f tl -> append (fmap f fa) (apply tl fa)
  }

witness Traversable List :=
  { traverse := λf xs.
      deconstruct xs into
        Nil -> pure Nil
      | Cons a tail ->
        liftA2 Cons (f a) (traverse f tail)
  }

witness ∀α. Semigroup (List α) :=
  { mappend := append
  }

witness ∀α. Monoid (List α) :=
  { mempty := Nil
  }

witness ∀α. Display α |- Display (List α) :=
  { display := λxs.
      deconstruct xs into
        Nil       -> ""
      | Cons x xs -> "`x`; `xs`"
  }

witness ∀α. Eq α |- Eq (List α) :=
  { eq := λxs ys.
      deconstruct xs, ys into
        Cons x xs, Cons y ys -> eq x y and eq xs ys
      | Nil, Nil             -> true
      | otherwise            -> false
  }

empty :: ∀α. List α := Nil

is_empty :: ∀α. List α -> Bool :=
  λxs. deconstruct xs into Nil -> true | _ -> false

head :: ∀α. List α -> Perhaps α :=
  λxs. deconstruct xs into Cons a tail -> This a | otherwise -> Nope

tail :: ∀α. List α -> List α :=
  λxs. deconstruct xs into Cons a tail -> tail | tail -> tail

fold_right :: ∀z α. (α -> z -> z) -> z -> List α -> z :=
  λf z xs.
    deconstruct xs into
      Cons a tail -> f a (fold_right f z tail)
    | Nil         -> z

fold_left :: ∀z α. (z -> α -> z) -> z -> List α -> z :=
  λf z xs.
    deconstruct xs into
      Cons a tail -> fold_left f (f z a) tail
    | Nil         -> z

for_each :: ∀α. (α -> Unit) -> List α -> Unit := λf xs.
  let _ = map f xs in ()

map :: ∀α β. (α -> β) -> List α -> List β :=
  λf. fold_right (compose Cons f) Nil

bind :: ∀α β. (α -> List β) -> List α -> List β :=
  λf. fold_right (λx. append (f x)) Nil

cartesian :: ∀α β. List α -> List β -> List (α, β) :=
  λxs ys. bind (λx. map (λy. x, y) ys) xs

zip :: ∀α β. List α -> List β -> List (α, β) := λxs ys.
  deconstruct xs, ys into
    Cons x xs, Cons y ys -> Cons (x, y) (zip xs ys)
  | otherwise            -> Nil

unfold :: ∀α s. (s -> Perhaps (α, s)) -> s -> List α := λstep seed.
  deconstruct step seed into
    Nope -> Nil
  | This (element, next_seed) -> Cons element (unfold step next_seed)

append :: ∀α. List α -> List α -> List α :=
  λxs ys. fold_right Cons ys xs

reverse :: ∀α. List α -> List α :=
  fold_left (λz a. Cons a z) Nil

length :: ∀α. List α -> Int :=
  fold_right (λa z. 1 + z) 0

count :: ∀α. (α -> Bool) -> List α -> Int :=
  λp. fold_left (λz x. if p x then 1 + z else z) 0

filter :: ∀α. (α -> Bool) -> List α -> List α :=
  λp. bind (λx. if p x then Cons x Nil else Nil)

flatten :: ∀α. List (List α) -> List α := λxs.
  bind id xs

tabulate :: ∀α. Int -> (Int -> α) -> List α :=
  λc f.
    let loop = λi xs.
      if i < 0
        then xs
        else loop (i - 1) (Cons (f i) xs)
    in loop (c - 1) Nil

concat :: List Text -> Text := λxs.
  deconstruct xs into
    Cons t tail -> "`t``concat tail`"
  | Nil -> ""

singleton :: ∀α. α -> List α := λa. Cons a Nil

find_first :: ∀α. (α -> Bool) -> List α -> Perhaps α := λp xs.
  deconstruct xs into
    Nil -> Perhaps.empty
  | Cons x xs ->
    if p x then This x
    else find_first p xs

remove_first_if :: ∀α. (α -> Bool) -> List α -> (Perhaps α, List α) := λε list.
  let loop = λprefix suffix.
    deconstruct suffix into
      Cons x suffix ->
        if ε x then This x, List.append (List.reverse prefix) suffix
        else loop (Cons x prefix) suffix
    | Nil -> Nope, list
  in loop Nil list

remove :: ∀α. Int -> List α -> (Perhaps α, List α) := λindex list.
  let loop = λi prefix suffix.
    deconstruct suffix into
      Cons x suffix ->
        if i = index then This x, List.append (List.reverse prefix) suffix
        else loop (1 + i) (Cons x prefix) suffix
    | Nil -> Nope, list
  in loop 0 Nil list

text :: ∀α. Display α |- Text -> List α -> Text := λseparator list.
  deconstruct list into
    Cons x xs ->
      let tail = concat (map (λy. "`separator``y`") xs) in
      "`x``tail`"
  | Nil -> ""

module Associative:
  lookup :: ∀α β. Eq α |- α -> List (α, β) -> Perhaps β := λkey assoc.
    let loop = λxs.
      deconstruct xs into
        Cons (key', value) xs' ->
          if key' = key then pure value
          else loop xs'
      | Nil -> Nope
    in loop assoc

  insert :: ∀α β. Eq α |- α -> β -> List (α, β) -> List (α, β) :=
    λkey value. Cons (key, value)
