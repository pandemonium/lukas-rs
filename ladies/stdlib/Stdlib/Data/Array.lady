use Stdlib.Control.Enumerator.

module Array:
  foreign raw_len :: ∀α. Array α -> Int
  foreign raw_get :: ∀α. Array α -> Int -> Perhaps α

  length :: ∀α. Array α -> Int := raw_len
  get :: ∀α. Array α -> Int -> Perhaps α := raw_get


foreign Raw_Mutable_Array

opaque Mutable_Array ::= ∀α. Mutable Raw_Mutable_Array

module Mutable_Array:
  foreign raw_generate_shaped :: ∀α. Memory_Layout α |- Int -> (Int -> α) -> Raw_Mutable_Array
  foreign raw_from_enumerator_shaped :: ∀α enumeration. Memory_Layout α |- Int -> enumeration -> (enumeration -> Perhaps ((Int, α), enumeration)) -> Raw_Mutable_Array
  foreign raw_len :: ∀α. Raw_Mutable_Array -> Int
  foreign raw_get :: ∀α. Raw_Mutable_Array -> Int -> Perhaps α
  foreign raw_get_unchecked :: ∀α. Raw_Mutable_Array -> Int -> α
  foreign raw_get_niche_payload_unchecked :: ∀α. Raw_Mutable_Array -> Int -> α
  foreign raw_put :: ∀α. Raw_Mutable_Array -> Int -> α -> Perhaps α
  foreign raw_put_unchecked :: ∀α. Raw_Mutable_Array -> Int -> α -> α
  foreign raw_set_unchecked :: ∀α. Raw_Mutable_Array -> Int -> α -> Unit
  foreign raw_copy_unchecked :: Raw_Mutable_Array -> Int -> Raw_Mutable_Array -> Int -> Int -> Unit
  foreign raw_grow_with :: ∀α. Raw_Mutable_Array -> Int -> α -> Raw_Mutable_Array

  (* Think about how this function could be shared with the Readonly array. They have the same backing. *)
  generate :: ∀α. Memory_Layout α |- Int -> (Int -> α) -> IO (Mutable_Array α) := λlength mk_element.
    IO.suspend (λ_. Mutable (raw_generate_shaped length mk_element))

  from_enumerator :: ∀α enumeration. Memory_Layout α + Enumerator α enumeration |- Indexed_Enumerator α enumeration -> IO (Mutable_Array α) :=
    λenumerator.
      let size = Indexed_Enumerator.size enumerator in
      IO.suspend (λ_. Mutable (raw_from_enumerator_shaped size enumerator Indexed_Enumerator.advance))

  length :: ∀α. Mutable_Array α -> Int := λ(Mutable array). raw_len array

  get :: ∀α. Mutable_Array α -> Int -> IO (Perhaps α) := λ(Mutable array) index.
    IO.suspend (λ_. raw_get array index)

  put :: ∀α. Mutable_Array α -> Int -> α -> IO (Perhaps α) := λ(Mutable array) index element.
    IO.suspend (λ_. raw_put array index element)

  get_unchecked :: ∀α. Mutable_Array α -> Int -> IO α := λ(Mutable array) index.
    IO.suspend (λ_. raw_get_unchecked array index)

  (* Pure escape hatch for implementing a larger atomic IO operation. Callers must *)
  (* ensure the result does not outlive the surrounding operation or race a write.  *)
  unsafe_get_unchecked :: ∀α. Mutable_Array α -> Int -> α := λ(Mutable array) index.
    raw_get_unchecked array index

  (* The caller proves that `index` is in bounds and that this slot contains the *)
  (* payload constructor of the top-level unary niche sum. Only its field is     *)
  (* decoded; the enclosing coproduct is never rebuilt.                          *)
  unsafe_get_niche_payload_unchecked :: ∀α. Mutable_Array (Perhaps α) -> Int -> α :=
    λ(Mutable array) index. raw_get_niche_payload_unchecked array index

  put_unchecked :: ∀α. Mutable_Array α -> Int -> α -> IO α := λ(Mutable array) index element.
    IO.suspend (λ_. raw_put_unchecked array index element)

  set_unchecked :: ∀α. Mutable_Array α -> Int -> α -> IO Unit := λ(Mutable array) index element.
    IO.suspend (λ_. raw_set_unchecked array index element)

  (* Copy packed elements without rebuilding their canonical values. Source and *)
  (* target ranges must be in bounds; overlapping ranges have memmove semantics. *)
  copy_unchecked :: ∀α. Mutable_Array α -> Int -> Mutable_Array α -> Int -> Int -> IO Unit :=
    λ(Mutable source) source_index (Mutable target) target_index count.
      IO.suspend (λ_. raw_copy_unchecked source source_index target target_index count)

  (* Preserve the packed prefix and initialize the enlarged suffix from one value. *)
  (* The runtime flattens that value once; an all-zero niche value needs no writes.  *)
  grow_with :: ∀α. α -> Int -> Mutable_Array α -> IO (Mutable_Array α) :=
    λfill new_length (Mutable source).
      IO.suspend (λ_. Mutable (raw_grow_with source new_length fill))

  modify_unchecked :: ∀α. Mutable_Array α -> Int -> (α -> α) -> IO α := λ(Mutable array) index f.
    let previous = raw_get_unchecked array index in
    let element = f previous in
    pure (raw_put_unchecked array index element)

  modify_at :: ∀α. Mutable_Array α -> Int -> (α -> α) -> IO Unit := λ(Mutable array) index f.
    IO.suspend (λ_.
      let previous = raw_get_unchecked array index in
      let element = f previous in
      raw_set_unchecked array index element)

  fill_range :: ∀α. Mutable_Array α -> Int -> Int -> α -> IO Unit := λ(Mutable array) start count element.
    let end = start + count in
    let loop = λi.
      if i <= end then
        raw_set_unchecked array i element
        loop (1 + i)
      else ()
    in IO.suspend (λ_. loop start)

  to_list :: ∀α. Mutable_Array α -> Int -> Int -> IO (List α) := λ(Mutable array) start length.
    let last = start + length - 1 in
    let loop = λindex acc.
      if index >= start then
        let element = raw_get_unchecked array index in
        loop (index - 1) (Cons element acc)
      else acc
    in
      IO.suspend (λ_. loop last List.empty)

witness Foldable Array :=
  { fold_right := λstep initial as.
      let loop = λi acc.
        if i < 0 then
          acc
        else
          deconstruct Array.get as i into
            This x -> loop (i - 1) (step x acc)
          | Nope   -> loop (i - 1) acc
      in
        loop (Array.length as - 1) initial

    fold_left := λstep initial as.
      let length = Array.length as in
      let loop = λi acc.
        if i >= length then
          acc
        else
          deconstruct Array.get as i into
            This x -> loop (i + 1) (step acc x)
          | Nope   -> loop (i + 1) acc
      in
        loop 0 initial
  }
