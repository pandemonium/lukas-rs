witness ∀α. Default α |- Default (Perhaps α) :=
  { default_value := Perhaps.empty
  }

witness Functor Perhaps :=
  { fmap := λf fa.
      deconstruct fa into
        This a -> This (f a)
      | Nope   -> Nope
  }

witness Monad Perhaps :=
  { bind := λf ma.
      deconstruct ma into
        This a -> f a
      | Nope   -> Nope
  }

witness Applicative Perhaps :=
  { pure  := λx. This x
    apply := λap fa.
      deconstruct ap into
        This f -> fmap f fa
      | Nope   -> Nope
  }

witness Foldable Perhaps :=
  { fold_right := λstep z fa.
      deconstruct fa into
        This a -> step a z
      | Nope   -> z
    fold_left := λstep z fa.
      deconstruct fa into
        This a -> step z a
      | Nope   -> z
  }

witness ∀α. Semigroup α |- Semigroup (Perhaps α) :=
  { mappend := liftA2 mappend
  }

witness ∀α. Monoid α |- Monoid (Perhaps α) :=
  { mempty := This mempty
  }

witness ∀α. Display α |- Display (Perhaps α) :=
  { display := λt.
      deconstruct t into
        This x -> "`x`"
      | Nope   -> ""
  }

witness Traversable Perhaps :=
  { traverse := λf. perhaps (pure Nope) (compose (fmap This) f)
  }

(* `p = q` here would mean `Eq (Perhaps α)` -- this very witness -- so it must  *)
(* deconstruct first and compare the payloads through the `Eq α` premise.       *)
witness ∀α. Eq α |- Eq (Perhaps α) :=
  { eq := λp q.
      deconstruct p, q into
        This a, This b -> a = b
      | Nope,   Nope   -> true
      | otherwise      -> false
  }

empty :: ∀α. Perhaps α := Nope

is_this :: ∀α. Perhaps α -> Bool := λpa.
  deconstruct pa into This _ -> true | _ -> false

is_this_and :: ∀α. Perhaps α -> (α -> Bool) -> Bool := λpa p.
  deconstruct pa into
    This a -> p a
  | Nope   -> false

(* not (is_this pa) -- not is not implemented, lol. *)
is_empty :: ∀α. Perhaps α -> Bool := λpa.
  deconstruct pa into Nope -> true | _ -> false

map :: ∀α β. (α -> β) -> Perhaps α -> Perhaps β :=
  λf. perhaps Nope (compose This f)

bind :: ∀α β. (α -> Perhaps β) -> Perhaps α -> Perhaps β :=
  λf. perhaps Nope f

zip :: ∀α β. Perhaps α -> Perhaps β -> Perhaps (α, β) :=
  let tuple = λa b. a, b in
  liftA2 tuple
