(* Stdlib.Binary: combinators for working with binary data -- the Get reader monad, *)
(* the Put writer monad, checked slicing, ranges, memory-mapped files. The byte/buffer *)
(* PRIMITIVES (Bytes/Buffer + their accessors) live in the always-imported Prelude; this *)
(* module composes on their PUBLIC surface (Bytes.get_u8/slice/length, Buffer.put_u8/...) *)
(* and never touches the raw internals. Its own foreigns speak the opaque erased types. *)

use Stdlib.Control.
use Stdlib.Control.State.
use Stdlib.IO.

foreign Raw_Mmap

foreign raw_mmap_open   :: Text -> Result Int Raw_Mmap
foreign raw_mmap_close  :: Raw_Mmap -> Unit
foreign raw_mmap_len    :: Raw_Mmap -> Int
foreign raw_mmap_get_u8 :: Raw_Mmap -> Int -> Int
foreign raw_mmap_closed :: Raw_Mmap -> Bool
foreign raw_mmap_slice  :: Raw_Mmap -> Int -> Int -> Result Int Bytes
foreign raw_mmap_read   :: Raw_Mmap -> Int -> Int -> Result Int Bytes
foreign raw_move_range  :: Buffer -> Int -> Int -> Result Int Bytes
foreign raw_copy_range  :: Buffer -> Int -> Int -> Result Int Bytes
foreign raw_write_file  :: Bytes -> Text -> Int

Mmap_Error   ::= Mmap_io Int
Buffer_Error ::= Out_of_range

(* It is not obvious that this is the correct solution. Is there really *)
(* just the one way to read an Int from a byte slice? *)
witness From Bytes (Perhaps Int) :=
  { from := λbs.
      let length = Bytes.length bs in
      print_endline "from: length `length`"
      let zero = Int.of_char '0' in
      let nine = Int.of_char '9' in
      let compute = λacc i.
        if i < length then
          let digit = Bytes.get_u8 bs i in
          if digit >= zero and digit <= nine then
            compute (10 * acc + digit - zero) (i + 1)
          else
            Nope
        else
          This acc
      in compute 0 0
  }

witness Display Read_Error :=
  { display := λ_. "out of bounds"
  }

witness Display Mmap_Error :=
  { display := λ(Mmap_io code). "mmap error `code`"
  }

witness Display Buffer_Error :=
  { display := λ_. "out of range"
  }

(* Checked, fallible views over the Prelude's unchecked `Bytes.slice`/`Bytes.split_at`. *)
slice :: Bytes -> Int -> Int -> Result Read_Error Bytes := λbs off n.
  if (0 <= off) and (0 <= n) and (off + n <= Bytes.length bs)
    then Return (Bytes.slice bs off n)
    else Fault Out_of_bounds

split_at :: Bytes -> Int -> Result Read_Error (Bytes, Bytes) := λbs n.
  if (0 <= n) and (n <= Bytes.length bs)
    then Return (Bytes.split_at bs n)
    else Fault Out_of_bounds

(* Read `width` bytes at the cursor with `rd`, advancing by `width`; fault (without *)
(* advancing) if the read would run past `len`. *)
read_at :: Int -> Int -> (Int -> Int) -> ExceptT (State Int) Read_Error Int :=
  λwidth len rd.
    let* pos = ExceptT.lift get in
    if (0 <= pos) and (pos + width <= len)
      then let* _ = ExceptT.lift (modify (λp. p + width)) in pure (rd pos)
      else ExceptT.throw Out_of_bounds

(* Ranged buffer variants: hand out only [off, off+n). `move_range` is zero-copy (and *)
(* resets the buffer, like `Buffer.move`); `copy_range` makes an independent copy. *)
tag_range :: Result Int Bytes -> Result Buffer_Error Bytes := λr.
  deconstruct r into
    Return bs -> Return bs
  | Fault _   -> Fault Out_of_range

move_range :: Buffer -> Int -> Int -> IO (Result Buffer_Error Bytes) := λbuf off n.
  let* r = IO.suspend (λ_. raw_move_range buf off n) in
  pure (tag_range r)

copy_range :: Buffer -> Int -> Int -> IO (Result Buffer_Error Bytes) := λbuf off n.
  let* r = IO.suspend (λ_. raw_copy_range buf off n) in
  pure (tag_range r)

write_file :: Bytes -> Text -> IO Int := λbs path.
  IO.suspend (λ_. raw_write_file bs path)

(* Map a whole file to Bytes; the mapping's lifetime is the GC's (the Bytes borrows the *)
(* region). Faults (Mmap_io) only at the open. *)
(* Why is this function in Binary? *)
mmap :: Text -> IO (Result Mmap_Error Bytes) := λpath.
  let* opened = IO.suspend (λ_. raw_mmap_open path) in
  deconstruct opened into
    Fault code -> pure (Fault (Mmap_io code))
  | Return m   ->
      deconstruct raw_mmap_slice m 0 (raw_mmap_len m) into
        Return bs   -> pure (Return bs)
      | Fault code  -> pure (Fault (Mmap_io code))

(* ----------------------------------------------------------------- The Get monad *)
(* Get carries the Bytes in the monad (a Reader) alongside the cursor (State), so reads *)
(* are NULLARY and the source is supplied once, at `run_get`. Reads bounds-check the *)
(* public `Bytes.get_*` accessors via `read_at`. *)
Get ::= ∀e a. MkGet (Bytes -> ExceptT (State Int) e a)

run_get_t :: ∀e a. Get e a -> Bytes -> ExceptT (State Int) e a := λ(MkGet f). f

witness ∀e. Functor (Get e) :=
  { fmap := λf (MkGet g). MkGet (λs. fmap f (g s))
  }

witness ∀e. Applicative (Get e) :=
  { pure  := λa. MkGet (λ_. pure a)
    apply := λ(MkGet gf) (MkGet ga). MkGet (λs. apply (gf s) (ga s))
  }

witness ∀e. Monad (Get e) :=
  { bind := λk (MkGet g). MkGet (λs. bind (λa. run_get_t (k a) s) (g s))
  }

(* Supply the source and run the parser from cursor 0. *)
run_get :: ∀e a. Get e a -> Bytes -> Result e a := λ(MkGet f) s.
  eval (ExceptT.run (f s)) 0

(* Nullary reads: the full width x endianness gamut, bounds-checked and advancing. *)
u8     :: Get Read_Error Int := MkGet (λbs. read_at 1 (Bytes.length bs) (λp. Bytes.get_u8     bs p))
u16_le :: Get Read_Error Int := MkGet (λbs. read_at 2 (Bytes.length bs) (λp. Bytes.get_u16_le bs p))
u16_be :: Get Read_Error Int := MkGet (λbs. read_at 2 (Bytes.length bs) (λp. Bytes.get_u16_be bs p))
u32_le :: Get Read_Error Int := MkGet (λbs. read_at 4 (Bytes.length bs) (λp. Bytes.get_u32_le bs p))
u32_be :: Get Read_Error Int := MkGet (λbs. read_at 4 (Bytes.length bs) (λp. Bytes.get_u32_be bs p))
u64_le :: Get Read_Error Int := MkGet (λbs. read_at 8 (Bytes.length bs) (λp. Bytes.get_u64_le bs p))
u64_be :: Get Read_Error Int := MkGet (λbs. read_at 8 (Bytes.length bs) (λp. Bytes.get_u64_be bs p))
i16_le :: Get Read_Error Int := MkGet (λbs. read_at 2 (Bytes.length bs) (λp. Bytes.get_i16_le bs p))
i16_be :: Get Read_Error Int := MkGet (λbs. read_at 2 (Bytes.length bs) (λp. Bytes.get_i16_be bs p))
i32_le :: Get Read_Error Int := MkGet (λbs. read_at 4 (Bytes.length bs) (λp. Bytes.get_i32_le bs p))
i32_be :: Get Read_Error Int := MkGet (λbs. read_at 4 (Bytes.length bs) (λp. Bytes.get_i32_be bs p))
i64_le :: Get Read_Error Int := MkGet (λbs. read_at 8 (Bytes.length bs) (λp. Bytes.get_i64_le bs p))
i64_be :: Get Read_Error Int := MkGet (λbs. read_at 8 (Bytes.length bs) (λp. Bytes.get_i64_be bs p))

(* Get-level primitives: the parser's own access to source, cursor and failure. *)
fail :: ∀e a. e -> Get e a := λe. MkGet (λ_. ExceptT.throw e)

(* Lift a Get's error type along `via` (withExceptT specialised to Get). *)
map_error :: ∀d e a. (d -> e) -> Get d a -> Get e a := λvia (MkGet g).
  MkGet (λs. ExceptT.catch (g s) (λd. ExceptT.throw (via d)))

source   :: ∀e. Get e Bytes       := MkGet (λs. pure s)
position :: ∀e. Get e Int         := MkGet (λ_. ExceptT.lift get)
skip     :: ∀e. Int -> Get e Unit := λn. MkGet (λ_. ExceptT.lift (modify (λp. p + n)))
length   :: ∀e. Get e Int         := MkGet (λbs. pure (Bytes.length bs))

(* This is not cheap. *)
empty :: ∀e. Get e Bool :=
  let* pos = position in
  let* len = length in
  pure (pos < len)

(* Read n bytes at the cursor as a zero-copy sub-view (slice + advance). *)
take :: Int -> Get Read_Error Bytes := λn.
  let* s   = source in
  let* pos = position in
  deconstruct slice s pos n into
    Fault e    -> fail e
  | Return sub -> let* _ = skip n in pure sub

(* ----------------------------------------------------------------- The Put monad *)
(* The write-side dual of Get: the target Buffer lives in the monad (a Reader over IO), *)
(* so puts are nullary. Writes go through the Prelude's public `Buffer.put_*` (each IO). *)
Put ::= ∀a. MkPut (Buffer -> IO a)

run_put_t :: ∀a. Put a -> Buffer -> IO a := λ(MkPut f). f

witness Functor Put :=
  { fmap := λf (MkPut g). MkPut (λb. fmap f (g b))
  }

witness Applicative Put :=
  { pure  := λa. MkPut (λ_. pure a)
    apply := λ(MkPut gf) (MkPut ga). MkPut (λb. apply (gf b) (ga b))
  }

witness Monad Put :=
  { bind := λk (MkPut g). MkPut (λb. bind (λa. run_put_t (k a) b) (g b))
  }

run_put :: ∀a. Put a -> Buffer -> IO a := λ(MkPut f) b. f b

put_u8     :: Int -> Put Unit := λv. MkPut (λbuf. Buffer.put_u8    buf v)
put_u16_le :: Int -> Put Unit := λv. MkPut (λbuf. Buffer.put_16_le buf v)
put_u16_be :: Int -> Put Unit := λv. MkPut (λbuf. Buffer.put_16_be buf v)
put_u32_le :: Int -> Put Unit := λv. MkPut (λbuf. Buffer.put_32_le buf v)
put_u32_be :: Int -> Put Unit := λv. MkPut (λbuf. Buffer.put_32_be buf v)
put_u64_le :: Int -> Put Unit := λv. MkPut (λbuf. Buffer.put_64_le buf v)
put_u64_be :: Int -> Put Unit := λv. MkPut (λbuf. Buffer.put_64_be buf v)
put_slice  :: Bytes -> Put Unit := λbs. MkPut (λbuf. Buffer.put_slice buf bs)
