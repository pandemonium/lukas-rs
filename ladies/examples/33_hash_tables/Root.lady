use Stdlib.
use Stdlib.Data.Hash_Table.


main :: IO Unit :=
  let* table = Hash_Table.make_default 427 in
  let* _ = Hash_Table.insert 1 1 table in
  let* _ = Hash_Table.modify 1 1 table in
  let* value = Hash_Table.lookup 1 table in
  IO.output "The value is: `value`"

start := λ_.
  IO.unsafe_run_IO main
