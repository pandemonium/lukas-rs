use Stdlib.
use Stdlib.Data.Array.

(* Generic sum write benchmark. Every slot starts as Nope; the specialized *)
(* worker later writes both This payloads and Nope, including zero padding. *)

Box ::= ∀α.
  { base :: Int
    cell :: Perhaps α
  }

module Generic:
  write :: ∀α. Memory_Layout (Box α) |- (Int -> Box α) -> α -> Mutable_Array (Box α) -> Int -> Int :=
    λmake value table n.
      if n <= 0 then
        let _ = Mutable_Array.generate 0 make in 0
      else
        if n % 3 = 0 then
          let _ = unsafe_run_IO (Mutable_Array.set_unchecked table (n % 1048576) { base := n; cell := Nope }) in
          write make value table (n - 1)
        else
          let _ = unsafe_run_IO (Mutable_Array.set_unchecked table (n % 1048576) { base := n; cell := This value }) in
          write make value table (n - 1)

make_box :: Int -> Box Int := λ_. { base := 0; cell := Nope }

start := λ_.
  let table = Mutable_Array.generate 1048576 make_box in
  let _ = Generic.write make_box 42 table 50000000 in
  let box = unsafe_run_IO (Mutable_Array.get_unchecked table 1) in
  let score = deconstruct box.cell into This x -> box.base + x | Nope -> 0 in
  print_endline "generic-sum-write `score`"
