use Stdlib.
use Stdlib.Data.Array.

(* Generic packed-read benchmark. *)
(* Generic.sum is user-defined polymorphic code; its Memory_Layout dictionary *)
(* is the only specialization trigger. The concrete caller uses Pair. *)

Box ::= ∀α.
  { payload :: α
    count :: Int
  }

module Generic:
  modulus :: Int := 1000000007

  sum :: ∀α. Memory_Layout (Box α) |- (Int -> Box α) -> Mutable_Array (Box α) -> Int -> Int -> Int :=
    λmake table n acc.
      if n <= 0 then
        let _ = unsafe_run_IO (Mutable_Array.generate 0 make) in acc
      else
        let index = (n * 189812531) % 1048576 in
        let element = unsafe_run_IO (Mutable_Array.get_unchecked table index) in
        sum make table (n - 1) ((acc + element.count) % modulus)

make_box :: Int -> Box Int := λi. { payload := i; count := i + 1 }

start := λ_.
  let table = unsafe_run_IO (Mutable_Array.generate 1048576 make_box) in
  print_endline "generic-read `Generic.sum make_box table 50000000 0`"
