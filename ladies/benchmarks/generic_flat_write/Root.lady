use Stdlib.
use Stdlib.Data.Array.

(* Generic packed-record write benchmark. The replacement is a literal in *)
(* user-defined polymorphic code specialized only by Memory_Layout (Box alpha). *)

Box ::= ∀α.
  { payload :: α
    count :: Int
  }

module Generic:
  write :: ∀α. Memory_Layout (Box α) |- (Int -> Box α) -> α -> Mutable_Array (Box α) -> Int -> Int :=
    λmake value table n.
      if n <= 0 then
        let _ = Mutable_Array.generate 0 make in 0
      else
        let _ = unsafe_run_IO (Mutable_Array.set_unchecked table (n % 1048576) { payload := value; count := n })
        in write make value table (n - 1)

make_box :: Int -> Box Int := λi. { payload := i; count := 0 }

start := λ_.
  let table = Mutable_Array.generate 1048576 make_box in
  let _ = Generic.write make_box 42 table 50000000 in
  let box = unsafe_run_IO (Mutable_Array.get_unchecked table 1) in
  print_endline "generic-write `box.payload + box.count`"
