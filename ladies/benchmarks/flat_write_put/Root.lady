use Stdlib.
use Stdlib.Data.Array.

Pair ::= { x :: Int; y :: Int }

module Bench:
  cap :: Int := 1048576

  loop :: Mutable_Array Pair -> Int -> Int := λtable n.
    if n <= 0 then 0
    else
      let _ = unsafe_run_IO (Mutable_Array.put_unchecked table (n % cap) { x := n; y := n + 1 }) in
      loop table (n - 1)

start := λ_.
  let table = unsafe_run_IO (Mutable_Array.generate Bench.cap (λ_. { x := 0; y := 0 })) in
  let _ = Bench.loop table 50000000 in
  let pair = unsafe_run_IO (Mutable_Array.get_unchecked table 1) in
  print_endline "write-put `pair.x + pair.y`"
