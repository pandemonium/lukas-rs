use Stdlib.
use Stdlib.Data.Tree.
use Stdlib.Data.Hash_Table.
use Stdlib.Control.
use Stdlib.Random.
use Stdlib.IO.
use Stdlib.Threading.

module Stats.

Fault ::= File_IO (Binary.Mmap_Error)

witness Display Fault :=
  { display := λe.
      deconstruct e into
        File_IO e -> "file IO: `e`"
  }

(* Temperatures are stored as tenths -- an `Int` scaled by 10 (22.6 -> 226) -- so the
   hot path never boxes a `Float`. The `.1`-decimal is reconstructed only at display. *)
File_Row ::=
  { City        :: Text
    Temperature :: Int
  }

module File_Row:
  make :: Text -> Int -> File_Row := λcity temp.
    { City := city; Temperature := temp }

(* All tenths (x10 ints); avg keeps its precision because Sum stays integral. *)
Aggregate_Stats ::=
  { Min   :: Int
    Max   :: Int
    Sum   :: Int
    Count :: Int
  }

witness From File_Row Aggregate_Stats :=
  { from := λ({ City: city; Temperature: temp }).
      { Min := temp; Max := temp; Sum := temp; Count := 1 }
  }

witness Default Aggregate_Stats :=
  { default_value := { Min := Int.Maximum; Max := Int.Minimum; Sum := 0; Count := 0 }
  }

witness Default Text :=
  { default_value := ""
  }

module FNV1a:
  offset_basis := -3750763034362895579
  prime        := 1099511628211

  hash :: Bytes -> Int := λbytes.
    let length = Bytes.length bytes in

    let loop = λi hash_value.
      if i + 8 <= length then
        loop (i + 8) ((hash_value xor Bytes.get_u64_le bytes i) * prime)
      else if i < length then
        loop (i + 1) ((hash_value xor Bytes.get_u8 bytes i) * prime)
      else
        hash_value
    in
      loop 0 offset_basis

witness Stats.Hashable Text :=
  { compute_hash := λt.
      let bs = Text.to_bytes t in
      FNV1a.hash bs
  }

witness Semigroup Aggregate_Stats :=
  { mappend := λp q.
      { Min   := min p.Min q.Min
        Max   := max p.Max q.Max
        Sum   := p.Sum + q.Sum
        Count := p.Count + q.Count
      }
  }

witness Monoid Aggregate_Stats :=
  { mempty := default_value
  }

(* Present a tenths-scaled Int as a `.1`-decimal: 226 -> "22.6", -91 -> "-9.1". *)
format_tenths :: Int -> Text := λtenths.
  let sign      = if tenths < 0 then "-" else "" in
  let magnitude = if tenths < 0 then 0 - tenths else tenths in
  "`sign``magnitude / 10`.`magnitude % 10`"

(* Mean in tenths, rounded to the nearest tenth (half away from zero) -- Sum is already
   tenths, so this is just round(Sum / Count). Integer-only, so no Float ever appears. *)
mean_tenths :: Int -> Int -> Int := λsum count.
  if sum < 0 then
    0 - ((2 * (0 - sum) + count) / (2 * count))
  else
    (2 * sum + count) / (2 * count)

witness Display File_Row :=
  { display := λself.
      "City `self.City`, Temperature `format_tenths self.Temperature`"
  }

witness Display Aggregate_Stats :=
  { display := λself.
      "min `format_tenths self.Min`, max `format_tenths self.Max`, avg `format_tenths (mean_tenths self.Sum self.Count)`"
  }

advance_to_row_end :: Bytes -> Int -> Int := λsource i.
  let length = Bytes.length source in
  if i >= length
    then length
    else if Bytes.get_u8 source i = 10
      then 1 + i
      else advance_to_row_end source (1 + i)

chunks :: Bytes -> Int -> (Bytes, Int) -> Perhaps (Bytes, (Bytes, Int)) := λsource stride state.
  deconstruct state into
    (_, offset) ->
      let length = Bytes.length source in
      if offset >= length
        then Nope
        else
          let stop = advance_to_row_end source (min length (offset + stride)) in
          This (Bytes.slice source offset (stop - offset), (source, stop))

absorb :: Stats.Cheeky_Map Text Aggregate_Stats -> Stats.Cheeky_Map Text Aggregate_Stats -> IO (Stats.Cheeky_Map Text Aggregate_Stats) := λtarget source.
  let* _ = Stats.Cheeky_Map.merge source target in
  pure target

(* Chunk `i` by ARITHMETIC rather than by unfolding: both ends are the next row
   boundary at or after a fixed offset, so any worker can compute its own chunk from
   an index alone with nothing shared and nothing sequential. That is what lets a
   fixed pool pull work instead of a driver handing it out. *)
chunk_at :: Bytes -> Int -> Int -> Bytes := λsource stride i.
  let length = Bytes.length source in
  let start  = if i = 0 then 0 else advance_to_row_end source (min length (i * stride)) in
  let stop   = advance_to_row_end source (min length ((1 + i) * stride)) in
  Bytes.slice source start (stop - start)

(* One table per WORKER, not per chunk: a worker folds every chunk it draws into the
   same table, so the run allocates `workers` tables instead of one per chunk, and the
   parent merges `workers - 1` times instead of once per chunk. *)
aggregate_in_parallel :: Int -> Int -> Bytes -> IO (Stats.Cheeky_Map Text Aggregate_Stats) :=
  λworkers units_per_worker file_bytes.
    let length = Bytes.length file_bytes in
    (* Chunk COUNT is the knob, not a byte stride: the file is cut into
       `workers * units_per_worker` equal pieces, so the split scales with the input
       instead of needing a new stride every time the file changes size. Several units
       per worker is what lets the pool balance -- with exactly one each, a worker that
       draws a slow unit has nothing left to hand off. *)
    let units  = workers * units_per_worker in
    let stride = (length + units - 1) / units in
    Thread.par_pool workers units
      absorb
      (Stats.Cheeky_Map.make_default chunk_capacity)
      (λtable i. process_chunk_into table (chunk_at file_bytes stride i))

read_file_data :: Text -> IO (Result Fault (List (Text, Aggregate_Stats))) := λfile_path.
  let* file_bytes = Binary.mmap file_path in
  deconstruct file_bytes into
    Return file_bytes ->
      (* 16 workers (this machine's CPU count), 3 chunks each -- bologna's ratio.
         Measured: 1 chunk per worker is a hair faster on an idle machine but leaves
         the pool no balancing headroom at all; past ~3 it gets slower, since finer
         chunks buy nothing once the pool is self-balancing and cost a `Bytes.slice`
         and a boundary scan each. *)
      let* table = aggregate_in_parallel 16 3 file_bytes in
      fmap Return (Stats.Cheeky_Map.to_list table)
  | Fault e -> pure (Fault (File_IO e))

chunk_capacity :: Int := 8191

process_chunk_into :: Stats.Cheeky_Map Text Aggregate_Stats -> Bytes -> IO (Stats.Cheeky_Map Text Aggregate_Stats) := λtable file_bytes.
  let length = Bytes.length file_bytes in
  let loop = λi.
    if i < length then
      let city_bytes, temperature, next = parse_row file_bytes i in
      let city = Text.unsafe_from_bytes city_bytes in
      let aggregate = from (File_Row.make city temperature) in
      let* _ = Stats.Cheeky_Map.modify city aggregate table in
      loop next

      (* deconstruct Text.from_bytes city_bytes into
        This city ->
          let aggregate = from (File_Row.make city temperature) in
          let* _ = Stats.Cheeky_Map.modify city aggregate table in
          loop next
      | Nope ->
          omg_wtf_bbq "Bad UTF8 bytes"
          loop next *)

    else
      pure ()
  in
    let* _ = loop 0 in
    pure table

(* First index at or after `i` whose byte equals `delim`. *)
scan_to :: Bytes -> Int -> Int -> Int := λsource i delim.
  if Bytes.get_u8 source i = delim then i
  else scan_to source (i + 1) delim

(* Parse the temperature `[-]D[D].D` starting at `start` as TENTHS (x10 Int) -- no Float
   boxing at all. `22.6` -> 226, `-9.1` -> -91. Returns the value paired with the index
   of the next row. `digit = byte - '0'`. *)
parse_temperature :: Bytes -> Int -> (Int, Int) := λsource start.
  let neg = Bytes.get_u8 source start = Int.of_char '-' in
  let index, whole =
    if neg then
      2, (Bytes.get_u8 source (start + 1) - Int.of_char '0')
    else
      1, (Bytes.get_u8 source start - Int.of_char '0')
  in
    let value, consumed =
      if Bytes.get_u8 source (start + index) = Int.of_char '.' then
        whole * 10 + (Bytes.get_u8 source (start + index + 1) - Int.of_char '0'), index + 3
      else
        (10 * whole + (Bytes.get_u8 source (start + index) - Int.of_char '0')) * 10 + (Bytes.get_u8 source (start + index + 2) - Int.of_char '0'), index + 4
    in
      ((if neg then -value else value), start + consumed)

parse_row :: Bytes -> Int -> (Bytes, Int, Int) := λsource i.
  let semicolon = scan_to source i (Int.of_char ';') in
  let city_bytes = Bytes.slice source i (semicolon - i) in
  let temperature, next = parse_temperature source (semicolon + 1) in
  city_bytes, temperature, next

main :: IO Unit :=
  let* collated = read_file_data "ladies/benchmarks/billions/city-temperatures.txt" in

  deconstruct collated into
    Return data_list ->
      let* _ = IO.output "Billion row challenge. `List.length data_list` cities." in
      let* _ = traverse (λ(city,stat). IO.output "`city`: `stat`") data_list in
      pure ()
  | Fault e ->
      IO.output "Crashed: `e`"

(* How to pass input arguments? Provide an Args array? *)
start := λ_.
  unsafe_run_IO main
