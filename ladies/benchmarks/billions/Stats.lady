use Stdlib.Data.Array.

(* `unconfined opaque` is the trusted override, and this is what it is for. The
   structural rule infers `Cheeky_Map` confined -- it holds a `Mutable_Array` -- which
   would stop a chunk's finished table from crossing `join`. The override asserts what
   the checker cannot see: a chunk table is written by exactly one thread, and `join`
   is a happens-before edge, so by the time the parent touches it the writer has
   finished and no one else ever had a reference. Merging on arrival is the whole point
   -- going out through a `List` would allocate a cons cell and a pair per city per
   chunk purely to hand the same data over. *)
unconfined opaque Cheeky_Map ::= ∀α β.
  { Buckets :: Mutable_Array (Entry α β)
  }

Entry ::= ∀α β.
  { Entry_Key   :: Perhaps α
    Entry_Value :: β
  }

signature Hashable ::= ∀α.
  { compute_hash :: α -> Int
  }

witness ∀α β. Default α + Default β |- Default (Entry α β) :=
  { default_value := { Entry_Key := default_value; Entry_Value := default_value }
  }

positive_mod :: Int -> Int -> Int := λn modulus.
  let r = n % modulus in
  if r < 0 then r + modulus else r

module Cheeky_Map:
  make_default :: ∀α β. Default α + Default β |- Int -> IO (Cheeky_Map α β) :=
    λcapacity.
      let* bucket_store = Mutable_Array.generate capacity (λ_. default_value) in
      pure { Buckets := bucket_store }

  modify :: ∀α β. Eq α + Hashable α + Semigroup β |- α -> β -> Cheeky_Map α β -> IO Unit :=
    λkey new_value table.
      let hash = compute_hash key in
      let table_length = Mutable_Array.length table.Buckets in
      let initial_index = positive_mod hash table_length in

      let loop = λindex.
        let* elt = Mutable_Array.get_unchecked table.Buckets index in
        deconstruct elt.Entry_Key into
          This existing_key ->
            if existing_key = key then
                let new_entry =
                  { elt:
                    Entry_Value := mappend elt.Entry_Value new_value
                  }
                in
                  Mutable_Array.set_unchecked table.Buckets index new_entry
            else
              loop (positive_mod (1 + index) table_length)

        | Nope ->
            let new_entry =
              { Entry_Key   := This key
                Entry_Value := new_value
              }
            in
              Mutable_Array.set_unchecked table.Buckets index new_entry

      in
        let* _ = loop initial_index in
        pure ()

  merge :: ∀α β. Eq α + Hashable α + Semigroup β |- Cheeky_Map α β -> Cheeky_Map α β -> IO Unit :=
    λsource target.
      let length = Mutable_Array.length source.Buckets in
      let loop = λi.
        if i >= length
          then pure ()
          else
            let entry = Mutable_Array.unsafe_get_unchecked source.Buckets i in
            deconstruct entry.Entry_Key into
              Nope -> loop (1 + i)
            | This key ->
                let* _ = modify key entry.Entry_Value target in
                loop (1 + i)
      in loop 0

  to_list :: ∀α β. Cheeky_Map α β -> IO (List (α, β)) := λ({ Buckets: buckets }).
    let length = Mutable_Array.length buckets in
    let loop = λi acc.
      if i < length then
        let* e = Mutable_Array.get_unchecked buckets i in

        deconstruct e.Entry_Key into
          This key -> loop (1 + i) (Cons (key, e.Entry_Value) acc)
        | Nope     -> loop (1 + i) acc

      else
        pure acc
    in loop 0 List.empty
